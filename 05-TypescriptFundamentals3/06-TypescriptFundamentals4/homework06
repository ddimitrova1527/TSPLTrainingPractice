//Write a request status validator: given the current and the next status, print whether the transition is allowed (Submitted → In Review → Resolved; In Review → Waiting for Info → In Review)
const transitions = {
  Submitted: ["In Review"],
  "In Review": ["Resolved", "Waiting for Info"],
  "Waiting for Info": ["In Review"],
  Resolved: [],
};

const current = "Submitted";
const next = "Resolved";

if (!(current in transitions)) {
  throw new Error(`Unknown status: ${current}`);
}

const allowed = transitions[current].includes(next);
console.log(`${current} -> ${next}: ${allowed ? "allowed" : "NOT allowed"}`);

//Print a text table of requests: id, title padded to 25 characters, priority, status
const requests = [
  { id: 1, title: "Reset password", priority: 2, status: "Submitted" },
  {
    id: 2,
    title: "Printer not working on floor 3",
