//Generate test data: 10 request titles "Test request 01" … "Test request 10" with priorities cycling 1–5
const testData = [];
for (let i = 1; i <= 10; i++) {
  const title = `Test request ${i.toString().padStart(2, "0")}`;
  const priority = (i % 5) + 1;
  testData.push({ id: i, title, priority, status: "Submitted" });
}

//Stretch: print the allowed transitions as a matrix using nested loops
console.log("Allowed Transitions Matrix:");
console.log("-".repeat(60));

const statuses = Object.keys(transitions);
console.log("From\\To".padEnd(15), ...statuses.map((s) => s.padEnd(15)));

for (const from of statuses) {
  let row = from.padEnd(15);
  for (const to of statuses) {
    const isAllowed = transitions[from].includes(to);
    row += (isAllowed ? "✓" : "✗").padEnd(15);
  }
  console.log(row);
}
